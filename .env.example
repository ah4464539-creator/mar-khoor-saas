PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=markhoor
DB_PASSWORD=replace_me
DB_NAME=markhoor_saas
# Shared secret for the Vapi webhook (send as Bearer token or X-Vapi-Secret; not an HMAC signature)
VAPI_WEBHOOK_SECRET=replace_with_long_random_secret
# Alternative: secret key of a Vapi HMAC credential (SHA256, hex, payload {timestamp}.{body}); use one type per server URL
# VAPI_WEBHOOK_HMAC_SECRET=replace_with_hmac_secret_key
# VAPI_HMAC_SIGNATURE_HEADER=x-signature
# VAPI_HMAC_TIMESTAMP_HEADER=x-timestamp
# Separate shared secret for authenticated voice menu tools
VAPI_TOOL_SECRET=replace_with_another_long_random_secret

# Meta WhatsApp Cloud API webhook configuration
WHATSAPP_VERIFY_TOKEN=replace_with_unique_verification_token
META_APP_SECRET=replace_with_meta_app_secret

# Meta WhatsApp Cloud API sending (server-side only)
WHATSAPP_ACCESS_TOKEN=replace_with_meta_system_user_token
WHATSAPP_GRAPH_VERSION=v23.0
# AI reply retries (optional): attempts before dead-letter, first delay and max delay in seconds (doubles each time)
# WHATSAPP_AI_MAX_ATTEMPTS=5
# WHATSAPP_AI_RETRY_BASE_SECONDS=30
# WHATSAPP_AI_RETRY_MAX_SECONDS=900
# Approved Meta templates for messages outside the 24-hour window (names exactly as approved in WhatsApp Manager)
# Order status: body {{1}} = order number, {{2}} = status
# WHATSAPP_ORDER_STATUS_TEMPLATE=order_status_update
# WHATSAPP_ORDER_STATUS_TEMPLATE_LANG=en
# Booking reminder: body {{1}} = customer name, {{2}} = business name, {{3}} = date and time
# WHATSAPP_REMINDER_TEMPLATE=booking_reminder
# WHATSAPP_REMINDER_LANG=en

# Set to 1 to process opted-in WhatsApp replies from the Node service.
# WHATSAPP_AI_WORKER_ENABLED=1
# WHATSAPP_AI_WORKER_RESTAURANT_ID=
# Optional AI auto-reply worker; keep credentials server-side
OPENAI_API_KEY=replace_with_api_key
WHATSAPP_AI_MODEL=gpt-4o-mini

# Stripe (start with TEST keys: sk_test_... / whsec_...). Server-side only.
# Plans & single tools are billed on the Mar-Khoor platform account; webhook https://mar-khoor.com/webhooks/stripe
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Customer order payments use Stripe Connect (each restaurant's own account, money never held by Mar-Khoor).
# Secret of a SECOND webhook endpoint "listening to events on Connected accounts": https://mar-khoor.com/webhooks/payments/stripe
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me_connect
# Optional platform fee on customer card payments, in basis points (100 = 1%). Default 0.
# PAYMENTS_PLATFORM_FEE_BPS=0
# ORDER_PAYMENTS_ENABLED=0       # set to 0 to hide online card payment everywhere

# Monthly usage limits: hard (default: AI pauses at limit + grace) or soft (never pauses, warnings only)
# USAGE_LIMIT_MODE=hard
# USAGE_LIMIT_GRACE_PERCENT=10

# Optional plan prices in USD cents (see docs/number-routing.md)
# PLAN_CATALOG_JSON={"services":{"website":1900,"voice":4900},"voiceMinutes":300,"voiceExtra":15}

# Website builder (reuses OPENAI_API_KEY from the WhatsApp AI settings)
# SITE_AI_MODEL=gpt-4o-mini
# SITE_PUBLISH_FREE=1
# Security and retention (see docs/operations.md)
# TRUST_PROXY=1
# Days before personal text is deleted automatically (restaurants may choose 7-365 days for their own data)
# MESSAGE_RETENTION_DAYS=90
# TRANSCRIPT_RETENTION_DAYS=30
# AUDIT_RETENTION_DAYS=365
# Daily clean-up inside the Node service is OFF unless this is 1. Set it on production only (PR previews share the database).
# RETENTION_WORKER_ENABLED=1
# Monitoring: HTTPS webhook that receives error alerts as JSON (Slack/Discord incoming webhook or your own collector)
# ERROR_TRACKING_WEBHOOK_URL=https://hooks.example.com/replace_me
# APP_RELEASE=2026-11-26
# LOG_LEVEL=info
# SLOW_REQUEST_MS=3000

# Number provisioning (names only; see docs/number-routing.md)
# TELNYX_API_KEY=
# VAPI_API_KEY=
# VAPI_TELNYX_CREDENTIAL_ID=
# Automatic AI Caller numbers for paid Premium/Enterprise subscriptions (TELNYX_API_KEY, VAPI_API_KEY and
# VAPI_TEMPLATE_ASSISTANT_ID needed; VAPI_TELNYX_CREDENTIAL_ID optional, found in Vapi when unset):
# VAPI_TEMPLATE_ASSISTANT_ID=        # Vapi assistant copied for each restaurant (model, voice, tools -> /integrations/vapi/tools)
# TELNYX_MAX_MONTHLY_USD=15          # never auto-buy a number costing more than this per month
# TELNYX_MAX_UPFRONT_USD=15          # ...or more than this upfront
# TELNYX_REQUIREMENT_GROUP_AE=

# Enable the website assistant for automatically provisioned registrations after staging verification.
REGISTRATION_WEBSITE_ASSISTANT_ENABLED=false

# Password reset emails ("Forgot password?" on /restaurant.html).
# Public HTTPS origin used to build the reset link.
PUBLIC_BASE_URL=https://mar-khoor.com
MAIL_FROM="Mar-Khoor <no-reply@mar-khoor.com>"
# Option A: Hostinger (or any) mailbox over SMTP with implicit TLS.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@mar-khoor.com
SMTP_PASSWORD=
# Option B: Resend API instead of SMTP (used only when SMTP_* is not set).
# RESEND_API_KEY=
