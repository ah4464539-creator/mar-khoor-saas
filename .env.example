PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=markhoor
DB_PASSWORD=replace_me
DB_NAME=markhoor_saas
# Shared secret for the Vapi webhook (send as Bearer token or X-Vapi-Secret; not an HMAC signature)
VAPI_WEBHOOK_SECRET=replace_with_long_random_secret
# Alternative: secret key of a Vapi HMAC credential (SHA256, hex, payload {timestamp}.{body}); use one type per server URL
# VAPI_WEBHOOK_HMAC_SECRET=replace_with_hmac_secret_key
# VAPI_HMAC_SIGNATURE_HEADER=x-signature
# VAPI_HMAC_TIMESTAMP_HEADER=x-timestamp
# Separate shared secret for authenticated voice menu tools
VAPI_TOOL_SECRET=replace_with_another_long_random_secret

# Meta WhatsApp Cloud API webhook configuration
WHATSAPP_VERIFY_TOKEN=replace_with_unique_verification_token
META_APP_SECRET=replace_with_meta_app_secret

# Meta WhatsApp Cloud API sending (server-side only)
WHATSAPP_ACCESS_TOKEN=replace_with_meta_system_user_token
WHATSAPP_GRAPH_VERSION=v23.0

# Optional AI auto-reply worker; keep credentials server-side
OPENAI_API_KEY=replace_with_api_key
WHATSAPP_AI_MODEL=gpt-4o-mini

# Optional plan prices in USD cents (see docs/number-routing.md)
# PLAN_CATALOG_JSON={"services":{"website":1900,"voice":4900},"voiceMinutes":300,"voiceExtra":15}

# Website builder (reuses OPENAI_API_KEY from the WhatsApp AI settings)
# SITE_AI_MODEL=gpt-4o-mini
# SITE_PUBLISH_FREE=1
# Security and retention (see docs/operations.md)
# TRUST_PROXY=1
# TRANSCRIPT_RETENTION_DAYS=30
# AUDIT_RETENTION_DAYS=365

# Number provisioning (names only; see docs/number-routing.md)
# TELNYX_API_KEY=
# VAPI_API_KEY=
# VAPI_TELNYX_CREDENTIAL_ID=
# TELNYX_REQUIREMENT_GROUP_AE=
